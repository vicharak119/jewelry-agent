name = "jewelry-agent"
compatibility_date = "2024-09-23"
pages_build_output_dir = "public"

[[d1_databases]]
binding = "DB"
database_name = "jewelry-agent-db"
database_id = "6aab796c-cef4-4589-8ab0-63350f30c7b6"

[[r2_buckets]]
binding = "STORAGE"
bucket_name = "jewelry-agent-storage"

# JWT_SECRET is intentionally NOT defined here.
# It is set as an encrypted Secret in the Cloudflare Pages dashboard
# (Settings > Variables and Secrets > Add > Type: Secret).
# Because it is not declared in this file, deploys will not recreate it as a
# plaintext variable, and Cloudflare will not delete the Secret on deploy.
# NOTE: until the Secret is set, authentication fails closed by design.
